@@ -283,7 +283,7 @@ with tab_mapa:
 
     def _aplicar_visao(res_, visao_id_):
         if not visao_id_:
-            return res_, "Casa toda"
+            return res_, "Visão geral"
         arq = os.path.join(pasta, "B7_visao_filtros.csv")
         if not os.path.exists(arq):
             return res_, visao_label
